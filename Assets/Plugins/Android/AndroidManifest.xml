<?xml version="1.0" encoding="utf-8"?>
<!--
  Unity merges this into the manifest it (and the Meta XR SDK's setup
  wizard) generate for the Quest build, at Assets/Plugins/Android/AndroidManifest.xml.
  On top of whatever's already there from the Meta XR SDK setup:

    1. INTERNET permission — needed to reach the XpressMedia backend at all.
    2. usesCleartextTraffic="true" — lets the app talk to Config.BackendBaseURL
       over plain http:// during local dev (a LAN IP has no TLS cert). Turn
       this off (or switch BackendBaseURL to https://) before shipping.
    3. An intent-filter for xpressmedia://oauth-callback so Quest's system
       browser can hand control back to this app after MPARADISE sign-in.

  If the Meta XR SDK's setup wizard already created a manifest here, MERGE
  these pieces into it rather than replacing the whole file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:usesCleartextTraffic="true">
        <activity android:name="com.unity3d.player.UnityPlayerActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xpressmedia" android:host="oauth-callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
